<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glass_frame" android:layout_width="match_parent"
    android:layout_height="48dp" android:layoutDirection="rtl">
    <ImageView android:id="@+id/glass_backdrop" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="4dp" android:paddingBottom="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="20dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/glass_avatar" android:layout_width="20dp"
                android:layout_height="20dp" android:contentDescription="تصویر فرستنده" />
            <TextView android:id="@+id/glass_sender" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp"
                android:maxLines="1" android:ellipsize="end" android:textDirection="firstStrong"
                android:includeFontPadding="false" android:textStyle="bold" android:textSize="12sp" />
            <TextView android:id="@+id/glass_clock" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textDirection="ltr" android:textSize="10sp" />
        </LinearLayout>
        <TextView android:id="@+id/glass_preview" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|start"
            android:textDirection="firstStrong" android:includeFontPadding="false"
            android:maxLines="1" android:ellipsize="end" android:textSize="12sp" />
        <!-- Android's action row owns the accessible copy button in bounded states. -->
        <TextView android:id="@+id/glass_meta" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/glass_code" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
