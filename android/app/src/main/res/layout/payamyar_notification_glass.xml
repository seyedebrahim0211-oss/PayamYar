<?xml version="1.0" encoding="utf-8"?>
<!-- Compact Android heads-up. Keep primary information above the OEM height limit. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glass_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="90dp"
    android:background="@drawable/payamyar_notification_glass"
    android:layoutDirection="rtl">
    <ImageView
        android:id="@+id/glass_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/glass_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="تصویر فرستنده" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/glass_sender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textDirection="firstStrong"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/glass_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="پیام‌یار"
                    android:textSize="10sp"
                    android:textColor="#DEFFFFFF" />
            </LinearLayout>
            <TextView
                android:id="@+id/glass_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textDirection="ltr"
                android:textColor="#DEFFFFFF" />
        </LinearLayout>
        <TextView
            android:id="@+id/glass_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:gravity="right"
            android:textDirection="firstStrong"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:textColor="#FFFFFF" />
        <TextView
            android:id="@+id/glass_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/payamyar_notification_chip"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
