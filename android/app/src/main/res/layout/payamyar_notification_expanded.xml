<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded notification shade. Heads-up height remains controlled by Android/OEM. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glass_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="128dp"
    android:background="@drawable/payamyar_notification_glass"
    android:layoutDirection="rtl">
    <ImageView
        android:id="@+id/glass_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/glass_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="تصویر فرستنده" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/glass_sender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/glass_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="پیام‌یار • پیام جدید"
                    android:textSize="11sp"
                    android:textColor="#DEFFFFFF" />
            </LinearLayout>
            <TextView
                android:id="@+id/glass_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textDirection="ltr"
                android:textColor="#DEFFFFFF" />
        </LinearLayout>
        <TextView
            android:id="@+id/glass_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="10"
            android:ellipsize="end"
            android:textDirection="firstStrong"
            android:gravity="right"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="#FFFFFF" />
        <TextView
            android:id="@+id/glass_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/payamyar_notification_chip"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
